<mxfile host="app.diagrams.net"><diagram id="request-flow" name="Request flow"><mxGraphModel dx="960" dy="660" grid="0" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="660" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Four shared steps, then the tenant’s guard wraps every database statement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#1F1E1D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="900" height="26" as="geometry"/></mxCell><mxCell id="c3" value="Example: POST /v1/tenants/uscard/calculate-ndi. The highlighted module is the only tenant code that runs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="900" height="20" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=1;fillColor=#F1EFE8;strokeColor=#B9B7AC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24" y="206" width="912" height="322" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color='#63615B'&gt;5&lt;/font&gt;&amp;nbsp;&amp;nbsp;Inside the guard: everything that touches the shared database" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#63615B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="218" width="480" height="22" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font color='#63615B'&gt;1&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;PayloadLimitFilter&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Caps the body before parsing;&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;over the cap is 413&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="24" y="80" width="210" height="76" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font color='#63615B'&gt;2&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Security filter&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Validates the JWT;&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;an invalid token is 401&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="258" y="80" width="210" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font color='#63615B'&gt;3&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Tenant interceptor&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Path tenant must match the&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;token; builds TenantContext&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="492" y="80" width="210" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font color='#63615B'&gt;4&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Tenant guard&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Rate limit 429, concurrency&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;limit 503; neither waits&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="726" y="80" width="210" height="76" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Idempotency lookup&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Looks up the Idempotency-Key&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;for this tenant&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="76" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;CalculateNDI service&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Registry finds the calculator;&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;input converted to its own type&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="260" height="76" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;Stores the result&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;for this tenant&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="260" height="76" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="831" y="184"/><mxPoint x="170" y="184"/></Array></mxGeometry></mxCell><mxCell id="c17" value="controller enters the guard" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="162" width="200" height="18" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="calc-spi: TenantCalculator, the only contract with tenant modules" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="150" y="366" width="660" height="36" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="calculateNDI(ctx, input)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="490" y="334" width="180" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;tenant-uscard&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;UsCardCalculator: net income&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;less housing, debt, allowance&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#E6EEFB;strokeColor=#2C6FD6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="150" y="434" width="204" height="72" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;tenant-autofinance&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;AutoFinanceCalculator: gross&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;income less tax, obligations&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="378" y="434" width="204" height="72" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Next tenant module&lt;/b&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;One new module and one&lt;/font&gt;&lt;br&gt;&lt;font color='#63615B' style='font-size:11px'&gt;dependency line, nothing else&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="606" y="434" width="204" height="72" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2C6FD6;strokeWidth=2;exitX=0.1545;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;dashed=1;dashPattern=4 4;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.8455;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;dashed=1;dashPattern=4 4;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c20" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="registry picks uscard" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="408" width="160" height="18" as="geometry"/></mxCell><mxCell id="c30" value="&lt;font color='#63615B'&gt;6&lt;/font&gt;&amp;nbsp;&amp;nbsp;Postgres: every statement runs in a transaction opened for that tenant, under that tenant’s statement_timeout" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fontFamily=Inter;fontSize=13;fontColor=#1F1E1D;fillColor=#FFFFFF;strokeColor=#B9B7AC;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="24" y="560" width="912" height="44" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.2115;exitY=1;exitDx=0;exitDy=0;entryX=0.0779;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c13" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9B7AC;strokeWidth=1.25;exitX=0.7885;exitY=1;exitDx=0;exitDy=0;entryX=0.9221;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=5;fontFamily=Inter;fontSize=11;fontColor=#63615B;" edge="1" parent="1" source="c15" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="reads" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="103" y="340" width="60" height="18" as="geometry"/></mxCell><mxCell id="c34" value="writes" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="797" y="340" width="60" height="18" as="geometry"/></mxCell><mxCell id="c35" value="Step 4 sits above step 5 on purpose: the guard covers every statement, including the idempotency lookup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#63615B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="618" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>